# TuneClash Web Client - Vercel / Production Environment Variables
# In local development, these default to http://localhost:4000

# URL of your deployed Node/Express + Socket.io backend (e.g. Render, Railway, Fly.io)
NEXT_PUBLIC_API_URL=https://your-tuneclash-server.onrender.com

# Optional (defaults to NEXT_PUBLIC_API_URL if not provided)
NEXT_PUBLIC_SOCKET_URL=https://your-tuneclash-server.onrender.com
